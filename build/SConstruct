#!/usr/bin/env python
from os.path import join

rive_out = ARGUMENTS.pop("rive_out", "out/debug")
skia_out = ARGUMENTS.pop("skia_out", "out/debug")
SConscript("SConscript.common")
env = SConscript("../godot-cpp/SConstruct")
env["STATIC_AND_SHARED_OBJECTS_ARE_THE_SAME"] = True
rive_lib_dir = join("../build/rive", rive_out)
skia_dir = "../build/deps/skia"
skia_lib_dir = join(skia_dir, skia_out)

library_names = [
    "rive_skia_renderer", "rive", "skia", "rive_harfbuzz",
    "rive_sheenbidi", "rive_yoga", "miniaudio",
]
library_files = [
    File(join(rive_lib_dir, "librive_skia_renderer.a")),
    File(join(rive_lib_dir, "librive.a")),
    File(join(skia_lib_dir, "libskia.a")),
    File(join(rive_lib_dir, "librive_harfbuzz.a")),
    File(join(rive_lib_dir, "librive_sheenbidi.a")),
    File(join(rive_lib_dir, "librive_yoga.a")),
    File(join(rive_lib_dir, "libminiaudio.a")),
]
if not GetOption("clean"):
    for library in library_files:
        env.RequireFile(library)

# Keep these layout-affecting defines in sync with PREMAKE_ARGS in build/build.py.
env.Append(CPPDEFINES=[
    "WITH_RIVE_TEXT", "WITH_RIVE_LAYOUT", "WITH_RIVE_AUDIO",
    "MA_NO_RESOURCE_MANAGER", ("YOGA_EXPORT", ""),
])
env.Prepend(
    LIBS=library_names,
    LIBPATH=[rive_lib_dir, skia_lib_dir],
    CPPPATH=[
        "../src",
        "../thirdparty/rive-cpp",
        "../thirdparty/rive-cpp/include",
        "../thirdparty/rive-cpp/skia/renderer/include",
        skia_dir,
    ],
)

if env["platform"] == "linux":
    env["_LIBFLAGS"] = "-Wl,--start-group " + env["_LIBFLAGS"] + " -Wl,--end-group"
    env.Append(LIBS=["pthread", "dl", "m"])
elif env["platform"] == "macos":
    for framework in ("CoreText", "CoreGraphics", "CoreFoundation", "CoreAudio", "AudioToolbox"):
        env.Append(LINKFLAGS=["-framework", framework])

sources = env.GlobRecursive("../src", "*.cpp")
if env["platform"] == "macos":
    library = env.SharedLibrary(
        "../demo/bin/librive.{}.{}.framework/librive.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary("../demo/bin/librive{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)

Default(library)
